{
  "manifest_schema_version": 3,
  "sdk_version": "5.13.0",
  "app_id": "mailchimp-connector",
  "version": "0.1.0",
  "name": "Mailchimp",
  "description": "Connect Mailchimp Marketing API to manage audiences, contacts, tags, campaigns, and reports.",
