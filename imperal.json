    {
      "name": "connect_mailchimp",
      "description": "Connect a Mailchimp account using an API key and verify it against the account endpoint.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "create:connection"
      ],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "label": {
            "default": "",
            "description": "Friendly label, e.g. Main marketing account.",
            "title": "Label",
            "type": "string"
          },
          "api_key": {
            "description": "Mailchimp API key including its data-center suffix, e.g. ...-us21.",
            "title": "Api Key",
            "type": "string"
          }
        },
        "required": [
          "api_key"
        ],
        "title": "ConnectMailchimpParams",
        "type": "object"
      },
      "return_schema": {
        "properties": {
          "connection_id": {
            "default": "",
            "title": "Connection Id",
            "type": "string"
          },
          "label": {
            "default": "",
            "title": "Label",
            "type": "string"
          }
        },
        "title": "ConnectionResult",
        "type": "object"
      },
      "event": "mailchimp-connector.connect_mailchimp",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "tool_mailchimp-connector_chat"
    },
